{
  "imports": {
    "@shared/": "./_shared/",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@0.95.1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.105.4",
    "openai": "npm:openai@6.37.0",
    "zod": "npm:zod@4.4.3"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-console"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true
  },
  "tasks": {
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check functions/**/*.ts _shared/**/*.ts"
  }
}
